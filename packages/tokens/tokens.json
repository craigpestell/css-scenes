{
  "$comment": "The `phase` group (day/night scene palette) is not yet consumed by packages/build: scenes/day-night-hillside/scene.css carries matching @property blocks and values until a phase emitter exists. Keep both in sync.",
  "color": {
    "ink": {
      "light": "#14121f",
      "dark": "#f4f1ff",
      "syntax": "<color>"
    },
    "paper": {
      "light": "#f4f1ff",
      "dark": "#0b0a14",
      "syntax": "<color>"
    },
    "accent": {
      "light": "#6d4aff",
      "dark": "#9d85ff",
      "syntax": "<color>"
    },
    "car-wall": {
      "light": "#e9e6dc",
      "dark": "#1a1826",
      "syntax": "<color>"
    },
    "seat": {
      "light": "#c9c4b4",
      "dark": "#2a2638",
      "syntax": "<color>"
    },
    "line": {
      "light": "#ff9500",
      "dark": "#ff9f1a",
      "syntax": "<color>"
    },
    "tunnel": {
      "light": "#05050a",
      "dark": "#05050a",
      "syntax": "<color>"
    },
    "lamp": {
      "light": "#ffe9b0",
      "dark": "#ffe9b0",
      "syntax": "<color>"
    },
    "platform": {
      "light": "#dfe9ff",
      "dark": "#9fb4e8",
      "syntax": "<color>"
    }
  },
  "duration": {
    "fast": "150ms",
    "base": "400ms",
    "slow": "1.2s",
    "drift": "24s",
    "rush": "1.6s",
    "swing": "3.6s"
  },
  "easing": {
    "out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "spring": "linear(0, 0.22 2.1%, 0.73 6.5%, 1.04 10.7%, 1.09 13%, 1.02 20%, 0.99 27%, 1)"
  },
  "angle": {
    "spin": {
      "initial": "0deg",
      "syntax": "<angle>"
    }
  },
  "phase": {
    "sky-top":   { "day": "#5aa9e6", "night": "#0e1230", "syntax": "<color>" },
    "sky-low":   { "day": "#ffd9a0", "night": "#3a2a5c", "syntax": "<color>" },
    "glow":      { "day": "#fff1c9", "night": "#6b5aa8", "syntax": "<color>" },
    "far-hill":  { "day": "#8fb8a0", "night": "#1d2748", "syntax": "<color>" },
    "mid-hill":  { "day": "#5f9a7a", "night": "#131a36", "syntax": "<color>" },
    "near-hill": { "day": "#3f7a5c", "night": "#0b1026", "syntax": "<color>" },
    "wall":      { "day": "#f2e3c8", "night": "#4a4466", "syntax": "<color>" },
    "roof":      { "day": "#c4553a", "night": "#5a2f3f", "syntax": "<color>" },
    "window":    { "day": "#5f87a8", "night": "#2a2748", "syntax": "<color>" }
  }
