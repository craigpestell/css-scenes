    {
      "name": "repeating-conic-gradient",
      "baseline": "widely available"
    },
    {
      "name": "clip-path: polygon()",
      "baseline": "widely available"
    },
    {
      "name": "sin() / cos()",
      "baseline": "widely available"
    },
    {
      "name": "sibling-index()",
      "baseline": "newly available (2026-08-18); --i fallback"
    },
    {
      "name": "light-dark()",
      "baseline": "newly available (2024-05-13)"
    },
    {
      "name": "prefers-reduced-motion",
      "baseline": "widely available"
    }
